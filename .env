# ================================
# VIKARETA ADMIN FRONTEND PRODUCTION ENVIRONMENT
# ================================

# ================================
# API CONFIGURATION (Production with Cloudflare SSL)
# ================================
NEXT_PUBLIC_API_URL=https://api.vikareta.com/api/v1
NEXT_PUBLIC_WS_URL=wss://api.vikareta.com
NEXT_PUBLIC_API_BASE=https://api.vikareta.com
NEXT_PUBLIC_APP_URL=https://admin.vikareta.com

# ================================
# DOMAIN CONFIGURATION (Shared across all auth modules)
# ================================
NEXT_PUBLIC_MAIN_DOMAIN=vikareta.com
NEXT_PUBLIC_DASHBOARD_DOMAIN=dashboard.vikareta.com
NEXT_PUBLIC_ADMIN_DOMAIN=admin.vikareta.com
NEXT_PUBLIC_API_DOMAIN=api.vikareta.com

# ================================
# AUTH CONFIGURATION
# ================================
NEXT_PUBLIC_AUTH_TYPE=unified
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=.vikareta.com

# ================================
# APP CONFIGURATION
# ================================
NEXT_PUBLIC_APP_NAME=Vikareta Admin

# ================================
# ADMIN CONFIGURATION
# ================================
NEXT_PUBLIC_ADMIN_EMAIL=admin@vikareta.com